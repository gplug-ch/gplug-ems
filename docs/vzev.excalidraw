    {
      "id": "JJQ2iFn6fcfdAbBhexPhS",
      "type": "text",
      "x": 1588.9049377441406,
      "y": 1035.80859375,
      "width": 493.47528076171875,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WlUv25_DNyfZ6rEKvWGI9"
      ],
      "frameId": null,
      "index": "bBK",
      "roundness": null,
      "seed": 1460009276,
      "version": 308,
      "versionNonce": 124886364,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772725937922,
      "link": null,
      "locked": false,
      "text": "priorisierter Schwellen‑Algorithmus mit Reihenfolge:\n\nÜberschuss = PV_Leistung − Hausverbrauch\n\nFür jeden Verbraucher in Prioritätsreihenfolge:\n  Wenn Verbraucher nicht aktiv AND\n     Überschuss >= Mindestleistung_des_Verbrauchers AND\n     Verbraucher.Zustand.nicht_geblockt ist\n  Dann:\n    Schalte Verbraucher ein\n    Verringere „Überschuss“ um die angestrebte Ladeleistung\n\nWenn Verbraucher läuft, aber Überschuss fällt unter einen\nkleineren Schwelle (z.B. 200 W):\n  Prüfe: ist die Mindestlaufzeit erreicht?\n    Wenn ja → schalte Verbraucher aus\n    Wenn nein → lasse Verbraucher weiterlaufen, bis\nMindestlaufzeit erreicht ist\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "priorisierter Schwellen‑Algorithmus mit Reihenfolge:\n\nÜberschuss = PV_Leistung − Hausverbrauch\n\nFür jeden Verbraucher in Prioritätsreihenfolge:\n  Wenn Verbraucher nicht aktiv AND\n     Überschuss >= Mindestleistung_des_Verbrauchers AND\n     Verbraucher.Zustand.nicht_geblockt ist\n  Dann:\n    Schalte Verbraucher ein\n    Verringere „Überschuss“ um die angestrebte Ladeleistung\n\nWenn Verbraucher läuft, aber Überschuss fällt unter einen kleineren Schwelle (z.B. 200 W):\n  Prüfe: ist die Mindestlaufzeit erreicht?\n    Wenn ja → schalte Verbraucher aus\n    Wenn nein → lasse Verbraucher weiterlaufen, bis Mindestlaufzeit erreicht ist\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
