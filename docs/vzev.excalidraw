      "versionNonce": 2147123036,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772725930705,
      "link": null,
      "locked": false,
      "text": "Das Energiemanagementsystem (EMS) ist\nverteilt und leitet den Strom aus dem Netz\nund von PV-Anlagen intelligent an die\nLasten. ",
      "fontSize": 20.054687500000004,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Das Energiemanagementsystem (EMS) ist verteilt und leitet den Strom aus dem Netz und von PV-Anlagen intelligent an die Lasten. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "tY6CxQeEQYADesUzltr-y",
